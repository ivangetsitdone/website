{$SITE_ADDRESS:ivangetsitdone.com} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	reverse_proxy app:8000 {
		# A deploy replaces the app container, and it needs a couple of seconds to start
		# serving. Hold the connection and retry rather than handing the visitor a 502:
		# a page that takes three seconds is a worse page, a 502 is no page at all.
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# Work-in-progress branches deploy to a separate container and stay out of search indexes.
# The preview container joins the production Compose network under the preview-app alias.
{$PREVIEW_ADDRESS:preview.ivangetsitdone.com} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}
	reverse_proxy preview-app:8000 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# The development site serves the working tree at /srv/website-dev, proxied on an internal
# alias like preview. Unindexed for the same reason, and for the same caveat: noindex
# discourages crawlers, it is not access control.
{$DEV_ADDRESS::8083} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}
	reverse_proxy dev-app:8000 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# www redirects to the bare domain, which is what every canonical URL names.
# Its own address rather than `www.{$SITE_ADDRESS}`, because SITE_ADDRESS is ":80"
# during a pre-DNS first boot and "www.:80" is not a valid site address.
{$WWW_ADDRESS:www.ivangetsitdone.com} {
	redir https://{$SITE_ADDRESS:ivangetsitdone.com}{uri} permanent
}
